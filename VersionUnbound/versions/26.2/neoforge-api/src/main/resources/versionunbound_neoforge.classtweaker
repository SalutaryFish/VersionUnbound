classTweaker	v1	official

# NeoForge's patch drops `sealed` from Holder so that DeferredHolder can implement it. Making it extendable removes the
# PermittedSubclasses attribute, at compile time (Loom) and at run time (Fabric Loader).
extendable	class	net/minecraft/core/Holder

# NeoForge's extension interfaces (its META-INF/injected-interfaces.json), added as each is ported.
inject-interface	net/minecraft/core/Registry	net/neoforged/neoforge/registries/IRegistryExtension<TT;>
inject-interface	net/minecraft/core/Holder	net/neoforged/neoforge/common/extensions/IHolderExtension<TT;>
inject-interface	net/minecraft/core/HolderSet	net/neoforged/neoforge/common/extensions/IHolderSetExtension<TT;>
inject-interface	net/minecraft/world/level/BaseSpawner	net/neoforged/neoforge/common/extensions/IOwnedSpawner
inject-interface	net/minecraft/world/level/block/entity/trialspawner/TrialSpawner	net/neoforged/neoforge/common/extensions/IOwnedSpawner
# Methods NeoForge's patches add to vanilla classes (see the patches package).
inject-interface	net/minecraft/resources/Identifier	net/salutaryfish/versionunbound/neoforge/patches/IdentifierExtension
inject-interface	net/minecraft/core/HolderLookup$RegistryLookup	net/salutaryfish/versionunbound/neoforge/patches/RegistryLookupExtension<TT;>
inject-interface	net/minecraft/core/HolderLookup$RegistryLookup$Delegate	net/salutaryfish/versionunbound/neoforge/patches/RegistryLookupExtension$Delegate<TT;>
inject-interface	net/minecraft/util/TriState	net/salutaryfish/versionunbound/neoforge/patches/TriStateExtension
inject-interface	net/minecraft/world/level/entity/PersistentEntitySectionManager	net/salutaryfish/versionunbound/neoforge/patches/PersistentEntitySectionManagerExtension<TT;>
inject-interface	net/minecraft/util/random/WeightedList$Builder	net/salutaryfish/versionunbound/neoforge/patches/WeightedListBuilderExtension<TE;>
inject-interface	net/minecraft/world/level/chunk/ChunkAccess	net/salutaryfish/versionunbound/neoforge/patches/ChunkAccessExtension
inject-interface	net/minecraft/world/entity/ai/attributes/AttributeSupplier$Builder	net/salutaryfish/versionunbound/neoforge/patches/AttributeSupplierBuilderExtension
inject-interface	net/minecraft/world/entity/Entity	net/salutaryfish/versionunbound/neoforge/patches/EntityExtension
