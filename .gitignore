# Reference material (HANDOFF.md §2). Committed: src/mc-*/, the FML sources and the test jars.
# The upstream clones are separate git repos; scripts/setup-src.sh clones them.
/src/mod_Src/test/
/src/mod_Src/main/*
!/src/mod_Src/main/FML-11.0.16/
# The user's jar folders also hold the mod repos' .git dirs and dotfiles; only the jars are committed.
/src/mod_Jars_*/*/*
!/src/mod_Jars_*/*/*.jar
!/src/mod_Jars_*/*/*.jar.part-[0-9][0-9]
# Over GitHub's 100 MB limit: committed as .part-NN pieces, joined by scripts/setup-src.sh.
/src/mod_Jars_1-21-1_Neoforge/cobblemon/Cobblemon-neoforge-1.8.4+1.21.1.jar
